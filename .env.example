# Docker Compose: browser access is http://SERVER_IP:3000 by default.
APP_PORT=3000
APP_BIND_ADDRESS=0.0.0.0

# Exact public origin (scheme + hostname + optional port), no path or trailing slash.
# For HTTPS reverse proxy use e.g. https://diary.example.com.
# Leave empty for direct same-origin access; this is not an access password.
PUBLIC_ORIGIN=

# Only enable behind a trusted reverse proxy that overwrites X-Real-IP.
TRUST_PROXY=0

# Native Node deployment only; Compose sets these inside the container.
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/diary.sqlite
